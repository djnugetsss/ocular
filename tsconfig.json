{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Explicit because jest-expo's globals are not referenced from expo-env.d.ts.
    "types": ["jest", "expo"],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  // `supabase/functions` is Deno, not React Native: it resolves `jsr:` and
  // `npm:` specifiers and relies on Deno's globals, none of which exist in
  // this project's compiler context. It is type-checked by `deno check`
  // (see supabase/functions/README.md), not here.
  "exclude": ["node_modules", "ios", "android", "dist", "supabase/functions"]
}
